# Copy to .env and fill in your values

# ── LLM backend: "openrouter" (default) or "ollama" ─────────────��────────────
LLM_BACKEND=openrouter

# OpenRouter (used when LLM_BACKEND=openrouter)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_LLM_MODEL=mistralai/ministral-14b-2512

# Ollama (used when LLM_BACKEND=ollama)
# Point to your Ollama instance — local or remote
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=ministral-3:14b

# Demo site base URLs (defaults for local Docker)
SHOPSPHERE_SSR_URL=http://localhost:8001
SHOPSPHERE_CSR_URL=http://localhost:8002
JOBHIVE_SSR_URL=http://localhost:8003
JOBHIVE_CSR_URL=http://localhost:8004

# Playwright service (if running separately)
PLAYWRIGHT_SERVICE_URL=http://localhost:3001
